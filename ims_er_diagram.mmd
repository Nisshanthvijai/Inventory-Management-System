erDiagram
  uom ||--o{ item : "unit of"
  brand ||--o{ item : makes
  item_type ||--o{ item : classifies
  item ||--o| stock : "has stock"
  profile ||--o{ purchase_requisition : raises
  purchase_requisition ||--|{ pr_line : contains
  item ||--o{ pr_line : requested
  pr_line ||--o{ po_line : "ordered as"
  vendor ||--o{ purchase_order : "placed with"
  profile ||--o{ purchase_order : creates
  purchase_order ||--|{ po_line : contains
  item ||--o{ po_line : ordered
  purchase_order ||--o{ goods_receipt : "received via"
  profile ||--o{ goods_receipt : records
  goods_receipt ||--|{ grn_line : contains
  po_line ||--o{ grn_line : "received against"

  uom {
    uuid id PK
    string code
    string name
  }
  brand {
    uuid id PK
    string name
  }
  item_type {
    uuid id PK
    string name
  }
  item {
    uuid id PK
    string code
    string name
    string description
    uuid brand_id FK
    uuid type_id FK
    uuid uom_id FK
    number reorder_level
    boolean is_active
  }
  stock {
    uuid id PK
    uuid item_id FK, UK
    number quantity
    timestamp updated_at
  }
  vendor {
    uuid id PK
    string name
    string address
    string gst_no
    string contact
  }
  profile {
    uuid id PK
    string full_name
    string role
  }
  purchase_requisition {
    uuid id PK
    date pr_date
    string priority
    uuid requested_by FK
    string status
  }
  pr_line {
    uuid id PK
    uuid pr_id FK
    uuid item_id FK
    number quantity
    number approved_quantity
    string status
  }
  purchase_order {
    uuid id PK
    date po_date
    uuid vendor_id FK
    uuid created_by FK
    string payment_terms
    string comments
    string status
  }
  po_line {
    uuid id PK
    uuid po_id FK
    uuid pr_line_id FK
    uuid item_id FK
    number price
    number quantity
    number gst
    date arrival_date
  }
  goods_receipt {
    uuid id PK
    uuid po_id FK
    date received_date
    string invoice_no
    date invoice_date
    string comments
    uuid received_by FK
  }
  grn_line {
    uuid id PK
    uuid grn_id FK
    uuid po_line_id FK
    number received_quantity
  }
