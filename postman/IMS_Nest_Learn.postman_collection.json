  "item": [
    {
      "name": "Health",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 and ok', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.eql({ status: 'ok' });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 with an access token', () => {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.access_token).to.be.a('string');",
              "  pm.collectionVariables.set('token', body.access_token);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Me",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/users/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 with a role', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().role).to.be.oneOf(['admin', 'manager', 'requestor']);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Me (no token, expect 401)",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "url": "{{baseUrl}}/users/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 standard error shape', () => {",
              "  pm.response.to.have.status(401);",
              "  pm.expect(pm.response.json().error).to.eql('UNAUTHORIZED');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Stock",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/stock"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 and an array', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create PR (creates a real PR)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"priority\": \"medium\",\n  \"lines\": [\n    { \"variant_id\": \"{{variantId}}\", \"quantity\": 2 }\n  ]\n}"
        },
        "url": "{{baseUrl}}/pr"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 with pr_no', () => {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.pr_no).to.be.a('string');",
              "  pm.expect(body.lines).to.eql(1);",
              "  pm.collectionVariables.set('prId', body.pr_id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "List PRs",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/pr"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 and an array with requester names', () => {",
              "  pm.response.to.have.status(200);",
              "  const rows = pm.response.json();",
              "  pm.expect(rows).to.be.an('array');",
              "  if (rows.length) pm.expect(rows[0]).to.have.property('requested_by_name');",
              "});"
            ]
