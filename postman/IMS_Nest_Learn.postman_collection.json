    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "variantId",
      "value": "ed005846-ca7e-47dc-8326-a22cca6ff073"
    },
    {
      "key": "prId",
      "value": ""
    },
    {
      "key": "prLineId",
      "value": ""
    },
    {
      "key": "vendorId",
      "value": "97f26946-a119-4545-926f-db42f68d5a4c"
    },
    {
      "key": "poId",
      "value": ""
    },
    {
      "key": "poLineId",
      "value": ""
    },
    {
      "key": "poVariantId",
      "value": ""
