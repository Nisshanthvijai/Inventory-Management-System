    {
      "name": "Decide line: accept 1 (manager/admin only)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"accepted\",\n  \"approved_quantity\": 1\n}"
        },
        "url": "{{baseUrl}}/pr-lines/{{prLineId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200, line accepted, PR status recalculated', () => {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.line_status).to.eql('accepted');",
              "  pm.expect(body.pr_status).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Decide line: approved above requested (expect 400)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
